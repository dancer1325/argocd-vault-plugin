FROM registry.access.redhat.com/ubi8

# Switch to root
#   Reason: perform install
#       _Example:_ required to `mv ${BIN} /usr/local/bin`
USER root

# Install tools / enable your repo-server to
#   retrieve & decrypt secrets
#   render manifests
RUN apt-get update && \
    apt-get install -y \
        curl \
        awscli \
        gpg && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Install the AVP plugin
ENV AVP_VERSION=1.18.0
ENV BIN=argocd-vault-plugin
RUN curl -L -o ${BIN} https://github.com/argoproj-labs/argocd-vault-plugin/releases/download/v${AVP_VERSION}/argocd-vault-plugin_${AVP_VERSION}_linux_amd64
RUN chmod +x ${BIN}
RUN mv ${BIN} /usr/local/bin

# Switch back to non-root user
USER 999